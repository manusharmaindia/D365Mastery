---
// ContactForm.astro
---

<form action="https://api.web3forms.com/submit" method="POST" class="bg-white rounded-3xl border border-purple-100 shadow-xl p-8 sm:p-10 space-y-6" id="contact-form">
  <!-- Web3Forms Access Key -->
  <input type="hidden" name="access_key" value="449e408e-28a8-402c-9a21-0e2e54b04094">
  <input type="hidden" name="subject" value="New Contact Request from D365 Mastery">
  <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div class="space-y-2">
      <label for="firstName" class="text-sm font-semibold text-[#2E1065]">First Name *</label>
      <input type="text" id="firstName" name="First Name" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#6D28D9] focus:border-transparent outline-none transition-all" />
    </div>
    <div class="space-y-2">
      <label for="lastName" class="text-sm font-semibold text-[#2E1065]">Last Name *</label>
      <input type="text" id="lastName" name="Last Name" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#6D28D9] focus:border-transparent outline-none transition-all" />
    </div>
  </div>

  <div class="space-y-2">
    <label for="email" class="text-sm font-semibold text-[#2E1065]">Email *</label>
    <input type="email" id="email" name="email" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#6D28D9] focus:border-transparent outline-none transition-all" />
  </div>

  <div class="space-y-2">
    <label for="inquiryType" class="text-sm font-semibold text-[#2E1065]">Reason for Contact *</label>
    <select id="inquiryType" name="Inquiry Type" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#6D28D9] focus:border-transparent outline-none transition-all appearance-none">
      <option value="" disabled selected>Select an option...</option>
      <option value="Networking">Networking</option>
      <option value="General Inquiry">General Inquiry</option>
      <option value="Collaboration">Collaboration</option>
      <option value="Other">Other</option>
    </select>
  </div>

  <div class="space-y-2">
    <label for="message" class="text-sm font-semibold text-[#2E1065]">Message</label>
    <textarea id="message" name="message" rows="4" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#6D28D9] focus:border-transparent outline-none transition-all resize-y"></textarea>
  </div>

  <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-base font-bold text-white bg-[#6D28D9] hover:bg-[#4C1D95] transition-colors shadow-md">
    <span>Send Message</span>
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </button>
  
  <p class="text-xs text-slate-400 text-center mt-4">
    We typically respond within 24 hours. Your information is kept confidential.
  </p>
</form>
