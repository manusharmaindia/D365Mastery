---
// ContactForm.astro
---

<form class="bg-white rounded-3xl border border-purple-100 shadow-xl p-8 sm:p-10 space-y-6" id="contact-form">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div class="space-y-2">
      <label for="firstName" class="text-sm font-semibold text-[#2E1065]">First Name *</label>
      <input type="text" id="firstName" name="firstName" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#6D28D9] focus:border-transparent outline-none transition-all" />
    </div>
    <div class="space-y-2">
      <label for="lastName" class="text-sm font-semibold text-[#2E1065]">Last Name *</label>
      <input type="text" id="lastName" name="lastName" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#6D28D9] focus:border-transparent outline-none transition-all" />
    </div>
  </div>

  <div class="space-y-2">
    <label for="email" class="text-sm font-semibold text-[#2E1065]">Work Email *</label>
    <input type="email" id="email" name="email" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#6D28D9] focus:border-transparent outline-none transition-all" />
  </div>

  <div class="space-y-2">
    <label for="inquiryType" class="text-sm font-semibold text-[#2E1065]">How can we help? *</label>
    <select id="inquiryType" name="inquiryType" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#6D28D9] focus:border-transparent outline-none transition-all appearance-none">
      <option value="" disabled selected>Select an option...</option>
      <option value="implementation">D365 F&O Implementation</option>
      <option value="architecture">Architecture Review</option>
      <option value="optimization">Performance Optimization</option>
      <option value="support">Production Support (L2/L3)</option>
      <option value="other">Other</option>
    </select>
  </div>

  <div class="space-y-2">
    <label for="message" class="text-sm font-semibold text-[#2E1065]">Message</label>
    <textarea id="message" name="message" rows="4" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl focus:ring-2 focus:ring-[#6D28D9] focus:border-transparent outline-none transition-all resize-y"></textarea>
  </div>

  <button type="submit" class="w-full inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-base font-bold text-white bg-[#6D28D9] hover:bg-[#4C1D95] transition-colors shadow-md">
    <span>Submit Request</span>
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </button>
  
  <p class="text-xs text-slate-400 text-center mt-4">
    We typically respond within 24 hours. Your information is kept confidential.
  </p>
</form>

<script>
  const form = document.getElementById('contact-form');
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      alert('Thank you for your inquiry. A consultant will be in touch shortly.');
      (e.target as HTMLFormElement).reset();
    });
  }
</script>
