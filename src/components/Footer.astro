---
const currentYear = new Date().getFullYear();

const blogCategories = [
  { name: "D365 F&O Architecture", href: "/blog?category=D365+F%26O" },
  { name: "X++ Development Patterns", href: "/blog?category=X%2B%2B+Development" },
  { name: "Data Management Framework", href: "/blog?category=Data+Management" },
  { name: "Azure & Dual-Write Integrations", href: "/blog?category=Integrations" },
  { name: "SQL & Batch Performance", href: "/blog?category=Performance+Optimization" },
  { name: "Production Support Playbooks", href: "/blog?category=Production+Support" },
];
---

<footer class="bg-secondary text-slate-300 border-t border-slate-800" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    <!-- Top Footer Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 xl:gap-12 pb-12 border-b border-slate-800">
      
      <!-- Company Brand & Mission -->
      <div class="lg:col-span-2 space-y-5">
        <a href="/" class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-xl bg-white p-1 shadow-md border border-slate-700 flex items-center justify-center overflow-hidden">
            <img src="/images/d365mastery-logo.png" alt="CA Manu Sharma Logo" class="w-full h-full object-contain" />
          </div>
          <div>
            <span class="text-xl font-bold font-display tracking-tight text-white">CA Manu Sharma</span>
            <span class="text-xs text-slate-400 block">Dynamics 365 F&amp;O Professional</span>
          </div>
        </a>

        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          Senior Functional Consultant specializing in Microsoft Dynamics 365 Finance & Operations. Passionate about sharing technical insights, architecture guides, and best practices with the community.
        </p>

        <!-- Location & Global Reach Badge -->
        <div class="flex items-center gap-2 text-xs text-slate-300 bg-slate-800/80 px-3.5 py-2 rounded-lg border border-slate-700/60 max-w-fit">
          <svg class="w-4 h-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Meerut, Uttar Pradesh, India</span>
        </div>

        <!-- Social Connections -->
        <div class="flex items-center flex-wrap gap-4 pt-1">
          <a
            href="https://www.linkedin.com/in/camanusharma/"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-xs font-semibold text-slate-300 hover:text-white bg-slate-800 hover:bg-[#0077b5] px-3 py-2 rounded-lg transition-colors border border-slate-700"
            aria-label="Connect on LinkedIn"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.2a1.6 1.6 0 0 0-1.6 1.6 1.6 1.6 0 0 0 1.6 1.6 1.6 1.6 0 0 0 1.6-1.6c0-.88-.72-1.6-1.6-1.6z"/>
            </svg>
            <span>Follow on LinkedIn</span>
          </a>
          <a
            href="https://www.youtube.com/@D365Mastery"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-2 text-xs font-semibold text-slate-300 hover:text-white bg-slate-800 hover:bg-[#FF0000] px-3 py-2 rounded-lg transition-colors border border-slate-700"
            aria-label="Subscribe on YouTube"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.501 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.377.55 9.377.55s7.505 0 9.377-.55a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            <span>Subscribe on YouTube</span>
          </a>
          <a
            href="mailto:sharma.manu.in@gmail.com"
            class="text-xs font-medium text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 px-3 py-2 rounded-lg transition-colors border border-slate-700"
          >
            sharma.manu.in@gmail.com
          </a>
        </div>
      </div>


      <!-- Technical Knowledge / Blog -->
      <div>
        <h3 class="text-sm font-semibold tracking-wider text-white uppercase font-display mb-4">Technical Hub</h3>
        <ul class="space-y-2.5">
          {blogCategories.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-400 hover:text-white hover:underline transition-colors">
                {link.name}
              </a>
            </li>
          ))}
          <li class="pt-2">
            <a href="/blog" class="text-xs font-semibold text-primary-300 hover:text-primary-200 flex items-center gap-1">
              <span>View All 8 Technical Guides</span>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright & Legal Disclaimer -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div class="space-y-1 text-center md:text-left">
        <p>© {currentYear} CA Manu Sharma. All rights reserved.</p>
        <p class="text-[11px] text-slate-500">
          Microsoft Dynamics 365, Azure, and Microsoft Power Platform are trademarks of Microsoft Corporation. This is a personal portfolio and is not affiliated with Microsoft.
        </p>
      </div>

      <div class="flex items-center gap-6">
        <a href="/about" class="hover:text-slate-300 transition-colors">About Me</a>
        <a href="/contact" class="hover:text-slate-300 transition-colors">Contact</a>
        <a href="/sitemap-index.xml" class="hover:text-slate-300 transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
