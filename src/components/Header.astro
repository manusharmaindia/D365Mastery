---
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.replace(/\/$/, "");

const navLinks = [
  { name: "About me", href: "/about" },
  { name: "Blog", href: "/blog" },
  { name: "GitHub", href: "https://github.com", external: true },
  { name: "LinkedIn", href: "https://www.linkedin.com/company/d365mastery", external: true },
  { name: "Udemy Courses", href: "/contact?ref=courses" },
  { name: "YouTube", href: "https://youtube.com", external: true },
];
---

<header class="sticky top-0 z-50 w-full bg-[#6D28D9] border-b border-[#4C1D95]/80 shadow-md transition-all duration-150">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-14 md:h-16">
      
      <!-- Brand Logo / Title -->
      <a href="/" class="flex items-center gap-2.5 group focus:outline-none" aria-label="D365Mastery">
        <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-white p-1 shadow-xs border border-white/20 flex items-center justify-center group-hover:scale-105 transition-transform overflow-hidden">
          <img src="/images/d365mastery-logo.png" alt="D365Mastery Logo" class="w-full h-full object-contain" />
        </div>
        <div class="flex flex-col">
          <span class="text-lg sm:text-2xl font-black font-display tracking-tight text-white group-hover:text-purple-100 transition-colors leading-none">
            D365Mastery
          </span>
          <span class="text-[9px] uppercase tracking-wider font-bold text-white/80 leading-tight">
            Dynamics 365 F&amp;O
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-5 xl:gap-6 text-xs sm:text-[13px] font-medium text-white" aria-label="Main Navigation">
        {navLinks.map((item) => {
          const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              target={item.external ? "_blank" : undefined}
              rel={item.external ? "noopener noreferrer" : undefined}
              class={`hover:text-purple-200 hover:underline underline-offset-4 decoration-2 transition-all ${
                isActive ? "font-bold underline text-white" : "text-white/80"
              }`}
            >
              {item.name}
            </a>
          );
        })}

        <!-- Search Icon Button -->
        <a
          href="/blog"
          class="p-1 text-white/90 hover:text-white hover:scale-110 transition-transform focus:outline-none"
          aria-label="Search articles"
          title="Search articles"
        >
          <svg class="w-4 h-4 stroke-[2.2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </a>

        <!-- Connect with me Button -->
        <a
          href="/contact"
          class="hidden lg:inline-flex items-center justify-center px-4 py-2 text-[11px] font-bold tracking-widest uppercase text-[#6D28D9] bg-white rounded-lg hover:bg-purple-50 transition-colors shadow-sm focus:outline-none"
        >
          <span>Connect with me</span>
        </a>
      </nav>

      <!-- Mobile Hamburger Button -->
      <div class="flex lg:hidden items-center gap-2">
        <a
          href="/blog"
          class="p-1.5 text-white/90 hover:text-white"
          aria-label="Search"
        >
          <svg class="w-5 h-5 stroke-[2.2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </a>
        <button
          type="button"
          id="mobile-menu-button"
          class="p-1.5 rounded-lg text-white hover:bg-white/10 focus:outline-none"
          aria-label="Open Navigation Menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="hamburger-icon" class="w-6 h-6 stroke-[2.2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="close-icon" class="w-6 h-6 stroke-[2.2] hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-[#4C1D95] bg-[#6D28D9] px-4 pt-2 pb-5 shadow-lg">
    <div class="flex flex-col space-y-2 text-sm font-medium text-white">
      {navLinks.map((item) => (
        <a
          href={item.href}
          target={item.external ? "_blank" : undefined}
          rel={item.external ? "noopener noreferrer" : undefined}
          class="py-1.5 px-2 rounded hover:bg-white/10 transition-colors"
        >
          {item.name}
        </a>
      ))}
      <div class="pt-2 border-t border-white/10">
        <a
          href="/contact"
          class="flex items-center justify-center w-full px-4 py-2.5 rounded-lg text-xs font-bold text-[#6D28D9] bg-white hover:bg-purple-50 transition-all text-center"
        >
          Connect with me
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const menuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');

  if (menuButton && mobileMenu && hamburgerIcon && closeIcon) {
    menuButton.addEventListener('click', () => {
      const isExpanded = menuButton.getAttribute('aria-expanded') === 'true';
      menuButton.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      hamburgerIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }
</script>
