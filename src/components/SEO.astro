---
export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  updatedDate?: Date;
  author?: string;
  keywords?: string[];
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description = "Premier Microsoft Dynamics 365 Finance & Operations (D365 F&O) consulting, technical architecture, X++ development, integrations, and production support for enterprise organizations.",
  canonical,
  image = "/images/og-image.png",
  type = "website",
  publishDate,
  updatedDate,
  author = "D365 Mastery Principal Architect",
  keywords = [
    "Dynamics 365 Finance and Operations Consultant",
    "D365 F&O Consulting",
    "Dynamics ERP Consultant",
    "D365 F&O Technical Consultant",
    "D365 F&O Support Services",
    "Dynamics 365 Implementation Services",
    "X++ Development",
    "Dynamics ERP Support",
    "ERP Modernization",
    "Dynamics 365 Architecture"
  ],
  breadcrumbs = [],
} = Astro.props;

const siteUrl = "https://d365mastery.com";
const canonicalURL = canonical || new URL(Astro.url.pathname, siteUrl).href;
const socialImageURL = new URL(image, siteUrl).href;
const fullTitle = title.includes("D365 Mastery") ? title : `${title} | D365 Mastery - Dynamics 365 F&O Consulting`;

// Structured Data: Organization & ProfessionalService
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  "@id": `${siteUrl}/#organization`,
  "name": "D365 Mastery",
  "url": siteUrl,
  "logo": `${siteUrl}/images/d365-mastery-logo.png`,
  "image": `${siteUrl}/images/og-image.png`,
  "description": "Enterprise Microsoft Dynamics 365 Finance & Operations consulting, implementation, solution architecture, X++ engineering, performance optimization, and managed support.",
  "address": {
    "@type": "PostalAddress",
    "addressCountry": "IN"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "12.9716",
    "longitude": "77.5946"
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "opens": "09:00",
    "closes": "20:00"
  },
  "priceRange": "$$$$",
  "sameAs": [
    "https://www.linkedin.com/company/d365mastery"
  ],
  "contactPoint": {
    "@type": "ContactPoint",
    "contactType": "Customer Support",
    "email": "contact@d365mastery.com",
    "areaServed": ["US", "EU", "GB", "IN", "AU", "AE"],
    "availableLanguage": ["English"]
  }
};

// Breadcrumb Schema
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": crumb.name,
    "item": crumb.url.startsWith("http") ? crumb.url : `${siteUrl}${crumb.url}`
  }))
} : null;

// Article Schema
const articleSchema = type === "article" ? {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL
  },
  "headline": title,
  "description": description,
  "image": socialImageURL,
  "author": {
    "@type": "Person",
    "name": author,
    "jobTitle": "Principal D365 F&O Solution Architect",
    "worksFor": {
      "@type": "Organization",
      "name": "D365 Mastery"
    }
  },
  "publisher": {
    "@type": "Organization",
    "name": "D365 Mastery",
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/images/d365-mastery-logo.png`
    }
  },
  "datePublished": publishDate ? publishDate.toISOString() : undefined,
  "dateModified": updatedDate ? updatedDate.toISOString() : (publishDate ? publishDate.toISOString() : undefined)
} : null;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords.join(", ")} />
<meta name="author" content={author} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

<!-- Open Graph / Facebook / LinkedIn -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageURL} />
<meta property="og:site_name" content="D365 Mastery" />
<meta property="og:locale" content="en_US" />
{publishDate && <meta property="article:published_time" content={publishDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImageURL} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
{breadcrumbSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
)}
{articleSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
)}
