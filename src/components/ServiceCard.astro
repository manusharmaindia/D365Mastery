---
export interface Props {
  title: string;
  description: string;
  icon: string;
  link: string;
}

const { title, description, icon, link } = Astro.props;
---

<a href={link} class="block group h-full">
  <div class="h-full bg-white rounded-2xl border border-purple-100 p-6 sm:p-8 hover:border-[#6D28D9] hover:shadow-lg transition-all duration-300 flex flex-col">
    <div class="w-12 h-12 rounded-xl bg-[#F3E8FF] text-[#6D28D9] flex items-center justify-center mb-6 group-hover:scale-110 transition-transform shadow-sm">
      <Fragment set:html={icon} />
    </div>
    
    <h3 class="text-lg sm:text-xl font-bold font-display text-[#2E1065] mb-3 group-hover:text-[#6D28D9] transition-colors">
      {title}
    </h3>
    
    <p class="text-sm text-slate-500 leading-relaxed mb-6 flex-grow">
      {description}
    </p>
    
    <div class="mt-auto flex items-center gap-1.5 text-[13px] font-bold text-[#6D28D9] uppercase tracking-wider">
      <span>Learn More</span>
      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </div>
  </div>
</a>
