---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
}).format(post.data.pubDate);

// Get related articles
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug && p.data.category === post.data.category)
  .slice(0, 3);
---

<BaseLayout
  title={`${post.data.title} | D365 Mastery`}
  description={post.data.description}
  type="article"
  publishDate={post.data.pubDate}
  updatedDate={post.data.updatedDate}
  author={post.data.author}
  keywords={post.data.tags}
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Blog", url: "/blog" },
    { name: post.data.title, url: `/blog/${post.slug}` }
  ]}
>
  <article class="bg-white pt-12 sm:pt-16 pb-24">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Back to Blog -->
      <a href="/blog" class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-400 hover:text-[#6D28D9] transition-colors mb-8 group">
        <svg class="w-3.5 h-3.5 group-hover:-translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
        Back to Blog
      </a>

      <!-- Category -->
      <div class="mb-4">
        <span class="text-[11px] font-semibold uppercase tracking-widest text-[#7C3AED]">
          {post.data.category}
        </span>
      </div>

      <!-- Title -->
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black font-display text-[#2E1065] tracking-tight leading-tight mb-5">
        {post.data.title}
      </h1>

      <!-- Author & Date -->
      <div class="flex items-center gap-3 pb-8 mb-8 border-b border-purple-100/50">
        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-[#6D28D9] to-[#A855F7] flex items-center justify-center text-white text-xs font-bold flex-shrink-0">
          {post.data.author.split(' ').map(n => n[0]).join('')}
        </div>
        <div class="text-sm">
          <span class="font-semibold text-slate-900">{post.data.author}</span>
          <span class="text-purple-200 mx-1.5">·</span>
          <time datetime={post.data.pubDate.toISOString()} class="text-slate-400">
            {formattedDate}
          </time>
          <span class="text-purple-200 mx-1.5">·</span>
          <span class="text-slate-400">{post.data.readingTime}</span>
        </div>
      </div>

      <!-- Article Content -->
      <div class="article-content">
        <Content />
      </div>

      <!-- Tags -->
      {post.data.tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-purple-100/50 flex flex-wrap items-center gap-2">
          {post.data.tags.map((tag) => (
            <span class="text-[11px] font-medium text-[#6D28D9] bg-[#F3E8FF] px-2.5 py-1 rounded-full border border-purple-100">
              {tag}
            </span>
          ))}
        </div>
      )}

      <!-- Related Articles -->
      {relatedPosts.length > 0 && (
        <div class="mt-14 pt-8 border-t border-purple-100/50">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-[#A855F7] mb-6">Related Articles</h3>
          <div class="space-y-4">
            {relatedPosts.map((related) => (
              <a
                href={`/blog/${related.slug}`}
                class="group flex items-center justify-between py-3 border-b border-purple-50 hover:border-purple-200 transition-colors"
              >
                <div>
                  <h4 class="text-sm font-semibold text-slate-900 group-hover:text-[#6D28D9] transition-colors">
                    {related.data.title}
                  </h4>
                  <span class="text-[11px] text-slate-400">{related.data.readingTime}</span>
                </div>
                <svg class="w-4 h-4 text-purple-200 group-hover:text-[#7C3AED] group-hover:translate-x-0.5 transition-all flex-shrink-0 ml-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Minimal CTA -->
      <div class="mt-16 p-8 rounded-xl bg-gradient-to-br from-[#F3E8FF] to-white border border-purple-100 text-center">
        <p class="text-sm font-semibold text-[#2E1065] mb-1">Need expert D365 F&amp;O guidance?</p>
        <p class="text-xs text-slate-500 mb-4">We help enterprises architect, implement, and optimize Dynamics 365.</p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-5 py-2.5 bg-[#6D28D9] text-white text-sm font-semibold rounded-lg hover:bg-[#7C3AED] transition-colors"
        >
          Book a Consultation
        </a>
      </div>

    </div>
  </article>
</BaseLayout>

<script>
  const shareBtn = document.getElementById('share-button');
  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      if (navigator.share) {
        navigator.share({
          title: document.title,
          url: window.location.href,
        }).catch(() => {});
      } else {
        navigator.clipboard.writeText(window.location.href);
        alert('Link copied to clipboard!');
      }
    });
  }
</script>

<style is:global>
  /* ==========================================================================
     Minimalistic Article Typography — Purple & White Theme
     ========================================================================== */
  .article-content {
    font-size: 1rem;
    line-height: 1.8;
    color: #334155;
  }

  .article-content p {
    margin-top: 1rem;
    margin-bottom: 1.25rem;
    line-height: 1.8;
  }

  .article-content strong,
  .article-content b {
    color: #2E1065;
    font-weight: 600;
  }

  .article-content h1 {
    font-size: 1.65rem;
    font-weight: 800;
    color: #2E1065;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }

  .article-content h2 {
    font-size: 1.35rem;
    font-weight: 700;
    color: #4C1D95;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid #E9D5FF;
    line-height: 1.35;
  }

  .article-content h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #2E1065;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .article-content hr {
    border: 0;
    border-top: 1px solid #F3E8FF;
    margin: 2rem 0;
  }

  .article-content ul,
  .article-content ol {
    margin: 1rem 0;
    padding-left: 1.25rem;
  }

  .article-content ul {
    list-style-type: disc;
  }

  .article-content ol {
    list-style-type: decimal;
  }

  .article-content li {
    margin-bottom: 0.4rem;
    line-height: 1.7;
  }

  .article-content li::marker {
    color: #A855F7;
  }

  /* Clean table styling with purple accents */
  .article-content table {
    width: 100% !important;
    display: table !important;
    border-collapse: collapse !important;
    border-spacing: 0 !important;
    margin-top: 1.5rem !important;
    margin-bottom: 2rem !important;
    border: 1px solid #E9D5FF !important;
    border-radius: 0.375rem !important;
    overflow: hidden !important;
    font-size: 0.875rem !important;
  }

  .article-content thead {
    border-bottom: 1px solid #E9D5FF !important;
  }

  .article-content th {
    background-color: #FAF5FF !important;
    color: #4C1D95 !important;
    font-weight: 600 !important;
    font-size: 0.8125rem !important;
    padding: 0.75rem 1rem !important;
    border: 1px solid #E9D5FF !important;
    text-align: left !important;
    vertical-align: middle !important;
  }

  .article-content td {
    padding: 0.75rem 1rem !important;
    border: 1px solid #F3E8FF !important;
    color: #334155 !important;
    font-size: 0.875rem !important;
    line-height: 1.6 !important;
    vertical-align: middle !important;
  }

  .article-content tbody tr:nth-child(even) td {
    background-color: #FDFAFF !important;
  }

  .article-content tbody tr:hover td {
    background-color: #FAF5FF !important;
  }

  .article-content img {
    border-radius: 0.5rem;
    margin: 1.5rem 0;
    border: 1px solid #F3E8FF;
    max-width: 100%;
    height: auto;
  }

  .article-content a {
    color: #6D28D9;
    text-decoration: underline;
    text-decoration-color: rgba(109, 40, 217, 0.3);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.15s;
  }

  .article-content a:hover {
    text-decoration-color: #6D28D9;
  }

  .article-content blockquote {
    border-left: 3px solid #E9D5FF;
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: #64748B;
    font-style: italic;
  }

  .article-content code {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85em;
    background-color: #FAF5FF;
    padding: 0.15rem 0.35rem;
    border-radius: 0.25rem;
    border: 1px solid #F3E8FF;
    color: #6D28D9;
  }

  .article-content pre code {
    background: none;
    padding: 0;
    border: none;
    border-radius: 0;
    color: inherit;
  }
</style>
