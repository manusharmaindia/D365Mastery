---
import BaseLayout from '../layouts/BaseLayout.astro';
import LeadCaptureCTA from '../components/LeadCaptureCTA.astro';
import BlogCard from '../components/BlogCard.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const featuredPosts = allPosts
  .filter((post) => post.data.featured)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

---

<BaseLayout
  title="Dynamics 365 Finance & Operations Consulting | D365 Mastery"
  description="D365 Mastery is a premier Microsoft Dynamics 365 Finance & Operations consulting practice helping organizations implement, optimize, modernize, integrate, and support enterprise ERP systems."
  breadcrumbs={[{ name: "Home", url: "/" }]}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 via-white to-white pt-16 pb-20 lg:pt-24 lg:pb-28 border-b border-slate-200/80">
    <div class="absolute inset-0 bg-grid-pattern opacity-40 [mask-image:radial-gradient(ellipse_at_center,transparent_20%,black)] pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-4xl mx-auto">
        
        <!-- Live Status Pill -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#F3E8FF] text-[#4C1D95] text-xs font-bold mb-8 shadow-xs border border-[#E9D5FF]">
          <span class="w-2 h-2 rounded-full bg-slate-950 animate-pulse"></span>
          <span>Enterprise Microsoft Dynamics 365 F&amp;O Advisory</span>
          <span class="text-slate-700">|</span>
          <span class="text-slate-900 font-semibold">Available Globally</span>
        </div>

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black font-display tracking-tight text-slate-950 leading-[1.15] text-balance mb-6">
          Dynamics 365 Finance &amp; Operations Consulting That <span class="text-[#1E3A5F] underline decoration-[#6D28D9] decoration-4 underline-offset-4">Delivers Results</span>
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-slate-600 leading-relaxed max-w-3xl mx-auto mb-10 font-normal">
          Helping organizations successfully implement, optimize, modernize, support and scale Microsoft Dynamics 365 Finance &amp; Operations with hands-on technical architecture and zero corporate fluff.
        </p>

        <!-- Hero CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
          <a
            href="/contact"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl text-base font-bold text-white bg-[#6D28D9] hover:bg-[#4C1D95] active:bg-[#3B0764] border border-[#4C1D95] shadow-md shadow-[#6D28D9]/30 transition-all duration-200 transform hover:-translate-y-0.5"
          >
            <span>Schedule Consultation</span>
            <svg class="w-5 h-5 stroke-[2.2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

        </div>

        <!-- 4 Core Trust Indicators -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 pt-10 border-t border-slate-200/80 text-left">
          <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-xs hover:border-[#6D28D9] transition-colors">
            <div class="w-8 h-8 rounded-lg bg-[#F3E8FF] text-[#6D28D9] flex items-center justify-center font-bold text-sm mb-2 shadow-2xs">
              <svg class="w-4 h-4 stroke-[2.2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div class="text-sm font-bold text-slate-900">D365 Expertise</div>
            <div class="text-xs text-slate-500 mt-0.5">Finance, SCM, WMS, Retail</div>
          </div>

          <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-xs hover:border-[#6D28D9] transition-colors">
            <div class="w-8 h-8 rounded-lg bg-[#F3E8FF] text-[#6D28D9] flex items-center justify-center font-bold text-sm mb-2 shadow-2xs">
              <svg class="w-4 h-4 stroke-[2.2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <div class="text-sm font-bold text-slate-900">Architecture Experience</div>
            <div class="text-xs text-slate-500 mt-0.5">Scalable Multi-Org Design</div>
          </div>

          <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-xs hover:border-[#6D28D9] transition-colors">
            <div class="w-8 h-8 rounded-lg bg-[#F3E8FF] text-[#6D28D9] flex items-center justify-center font-bold text-sm mb-2 shadow-2xs">
              <svg class="w-4 h-4 stroke-[2.2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
              </svg>
            </div>
            <div class="text-sm font-bold text-slate-900">Development Expertise</div>
            <div class="text-xs text-slate-500 mt-0.5">Clean X++, CoC &amp; SysOps</div>
          </div>

          <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-200/90 shadow-xs hover:border-[#6D28D9] transition-colors">
            <div class="w-8 h-8 rounded-lg bg-[#F3E8FF] text-[#6D28D9] flex items-center justify-center font-bold text-sm mb-2 shadow-2xs">
              <svg class="w-4 h-4 stroke-[2.2]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div class="text-sm font-bold text-slate-900">Production Support</div>
            <div class="text-xs text-slate-500 mt-0.5">Sev-1 Triage &amp; 24/7 SLA</div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Value Proposition Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-5 space-y-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-50 border border-primary/20 text-xs font-bold text-primary">
            <span>Why Enterprise Leaders Choose Us</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold font-display tracking-tight text-slate-900">
            Enterprise ERP Without The Bloat of Big SI Firms
          </h2>
          <p class="text-base text-slate-600 leading-relaxed">
            Traditional global system integrators staff D365 projects with bloated teams and inexperienced junior developers learning on your budget.
          </p>
          <p class="text-base text-slate-600 leading-relaxed">
            At <strong>D365 Mastery</strong>, you partner directly with senior architects who write production X++, engineer high-volume Azure integrations, and resolve database deadlocks hands-on.
          </p>

          <div class="pt-2 space-y-3 text-sm text-slate-700">
            <div class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-accent/20 text-accent flex items-center justify-center text-xs font-bold">✓</span>
              <span>Direct access to Senior Solution Architects from day one</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-accent/20 text-accent flex items-center justify-center text-xs font-bold">✓</span>
              <span>Zero overlayering, 100% upgrade-proof extension code</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-5 h-5 rounded-full bg-accent/20 text-accent flex items-center justify-center text-xs font-bold">✓</span>
              <span>Cost-effective global delivery model with India hub</span>
            </div>
          </div>

          <div class="pt-4">
            <a href="/about" class="inline-flex items-center gap-2 text-sm font-bold text-primary hover:text-primary-700">
              <span>Read About Our Architecture Philosophy</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Metric & Tech Architecture Highlights Box -->
        <div class="lg:col-span-7 bg-slate-900 rounded-3xl p-8 sm:p-10 text-white shadow-2xl border border-slate-800 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-primary/20 rounded-full blur-3xl pointer-events-none"></div>

          <h3 class="text-xl font-bold font-display text-white mb-6">
            D365 Mastery Engineering Pillars
          </h3>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="bg-slate-800/80 p-5 rounded-2xl border border-slate-700/80">
              <div class="text-2xl font-bold text-accent font-display">100%</div>
              <div class="text-sm font-semibold text-white mt-1">One Version Compliant</div>
              <div class="text-xs text-slate-400 mt-1">Extension-first architecture with strict CoC patterns that survive monthly Microsoft service updates.</div>
            </div>

            <div class="bg-slate-800/80 p-5 rounded-2xl border border-slate-700/80">
              <div class="text-2xl font-bold text-primary font-display">&lt; 15 Min</div>
              <div class="text-sm font-semibold text-white mt-1">Sev-1 Incident Triage</div>
              <div class="text-xs text-slate-400 mt-1">Rapid root cause analysis across Azure SQL telemetry, LCS activity logs, and AOS worker pools.</div>
            </div>

            <div class="bg-slate-800/80 p-5 rounded-2xl border border-slate-700/80">
              <div class="text-2xl font-bold text-accent font-display">25k+ / sec</div>
              <div class="text-sm font-semibold text-white mt-1">DMF Set-Based Records</div>
              <div class="text-xs text-slate-400 mt-1">Engineered data migration and package entities designed for zero-downtime cutovers.</div>
            </div>

            <div class="bg-slate-800/80 p-5 rounded-2xl border border-slate-700/80">
              <div class="text-2xl font-bold text-primary font-display">24/7</div>
              <div class="text-sm font-semibold text-white mt-1">Global Coverage</div>
              <div class="text-xs text-slate-400 mt-1">Seamless time-zone overlap across North America, UK/Europe, India, and Australia.</div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>



  <!-- Featured Blog Section -->
  <section class="py-20 bg-slate-50/70 border-t border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-50 border border-primary/20 text-xs font-bold text-primary mb-3">
            <span>D365 Thought Leadership</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold font-display tracking-tight text-slate-900">
            Latest Technical Insights &amp; Architecture Guides
          </h2>
          <p class="text-base text-slate-600 mt-2">
            In-depth guides on DMF, X++ clean code, Azure integrations, and performance tuning from senior architects.
          </p>
        </div>
        <div>
          <a href="/blog" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl text-xs font-bold text-white bg-slate-900 hover:bg-slate-800 transition-all shadow-sm">
            <span>Browse All 8 Articles</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featuredPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            slug={post.slug}
            pubDate={post.data.pubDate}
            category={post.data.category}
            readingTime={post.data.readingTime}
            tags={post.data.tags}
            featured={post.data.featured}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Conversion CTA Banner -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <LeadCaptureCTA
      headline="Ready to Modernize, Optimize, or Scale Your D365 F&O Environment?"
      subheadline="Speak directly with an enterprise Dynamics 365 Finance & Operations Principal Architect. Honest evaluations, zero junior bloat, and predictable delivery."
      primaryCtaText="Book Architecture Consultation"
      primaryCtaLink="/contact"
    />
  </div>
</BaseLayout>
