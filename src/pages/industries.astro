---
import BaseLayout from '../layouts/BaseLayout.astro';
import IndustryCard from '../components/IndustryCard.astro';
import LeadCaptureCTA from '../components/LeadCaptureCTA.astro';

const industries = [
  {
    title: "Process Manufacturing",
    description: "Deep expertise in formula management, batch orders, co-products, by-products, and multi-level Semi-Finished Good (SFG) cost absorption.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" /></svg>`
  },
  {
    title: "Discrete Manufacturing",
    description: "End-to-end BOM management, lean manufacturing, routing optimization, and master planning for complex assemblies.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`
  },
  {
    title: "Retail & Commerce",
    description: "Omnichannel commerce architectures, MPOS deployment, statement posting performance, and advanced pricing engines.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z" /></svg>`
  },
  {
    title: "Financial Services",
    description: "Advanced bank reconciliation automation (MT940/CAMT.053), automated collection letters, consolidation, and complex global GST/tax localizations.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`
  }
];
---

<BaseLayout
  title="Industries | D365 Mastery"
  description="We specialize in Dynamics 365 F&O solutions for Process Manufacturing, Discrete Manufacturing, Retail, and Financial Services."
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Industries", url: "/industries" }
  ]}
>
  <section class="py-16 sm:py-24 bg-white border-b border-purple-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black font-display text-[#2E1065] tracking-tight mb-6">
        Industry-Specific D365 Expertise
      </h1>
      <p class="text-base sm:text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
        We understand that out-of-the-box ERP rarely fits complex vertical requirements. Our team brings deep domain experience to architect solutions that align precisely with your industry's unique workflows.
      </p>
    </div>
  </section>

  <section class="py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
        {industries.map(ind => (
          <IndustryCard
            title={ind.title}
            description={ind.description}
            icon={ind.icon}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="pb-24 pt-8 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <LeadCaptureCTA
        headline="Does Your Partner Understand Your Industry?"
        subheadline="Talk to experts who have successfully navigated complex process manufacturing and retail D365 deployments."
        primaryCtaText="Let's Discuss Your Industry"
        primaryCtaLink="/contact"
      />
    </div>
  </section>
</BaseLayout>
