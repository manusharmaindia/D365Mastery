---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import LeadCaptureCTA from '../components/LeadCaptureCTA.astro';

const services = [
  {
    title: "D365 F&O Implementation",
    description: "End-to-end greenfield implementations of Dynamics 365 Finance & Operations tailored to your enterprise architecture.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>`,
    link: "/contact"
  },
  {
    title: "Solution Architecture",
    description: "Strategic blueprinting for multi-company deployments, ISV selection, and core business process modeling.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>`,
    link: "/contact"
  },
  {
    title: "X++ Development",
    description: "Clean, extensible X++ customizations using Chain of Command (CoC) and event handlers to avoid core code overlaying.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
    link: "/contact"
  },
  {
    title: "Data Migration (DMF)",
    description: "High-volume data migration strategies, BYOD exports, and Dataverse integrations using the Data Management Framework.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" /></svg>`,
    link: "/contact"
  },
  {
    title: "Performance Optimization",
    description: "Deep dive diagnostics to optimize slow SQL queries, batch jobs, integration bottlenecks, and deadlocks.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
    link: "/contact"
  },
  {
    title: "Production Support L2/L3",
    description: "Reliable post-go-live managed support to keep your operations running smoothly with rapid incident resolution.",
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`,
    link: "/contact"
  }
];
---

<BaseLayout
  title="Consulting Services | D365 Mastery"
  description="Expert consulting for Microsoft Dynamics 365 Finance & Operations. Implementation, architecture, X++ development, and performance optimization."
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Services", url: "/services" }
  ]}
>
  <section class="py-16 sm:py-24 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black font-display text-[#2E1065] tracking-tight mb-6">
        Specialized Dynamics 365 F&amp;O Consulting
      </h1>
      <p class="text-base sm:text-lg text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Whether you are planning a greenfield rollout, refactoring legacy AX customizations, optimizing slow SQL batch jobs, or seeking responsive L2/L3 production support, our architect-led team delivers precision engineering.
      </p>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {services.map(service => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
            link={service.link}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="pb-24 pt-8 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <LeadCaptureCTA
        headline="Ready to Optimize Your D365 F&O Environment?"
        subheadline="Connect with a Senior Architect to discuss your next big initiative, performance bottleneck, or implementation roadmap."
        primaryCtaText="Book a Discovery Call"
        primaryCtaLink="/contact"
      />
    </div>
  </section>
</BaseLayout>
